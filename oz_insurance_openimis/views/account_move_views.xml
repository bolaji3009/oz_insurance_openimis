<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Add insurance fields to invoice form view -->
        <record id="account_move_form_view_insurance" model="ir.ui.view">
            <field name="name">account.move.form.view.insurance</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <!-- Add insurance tab -->
                <xpath expr="//page[@name='other_info']" position="before">
                    <page name="insurance" string="Insurance">
                        <group name="insurance_claim" string="Insurance Claim">
                            <field name="is_insurance_claim"/>
                            <field name="care_setting"/>
                            <field name="coverage_ref"/>
                            <field name="insurer"/>
                            <field name="openimis_claim_id"/>
                            <field name="claim_status"/>
                            <field name="approved_total"/>
                            <field name="denied_total"/>
                        </group>
                        
                        <group name="actions" string="Actions" colspan="4">
                            <button name="action_submit_insurance_claim" 
                                    type="object" 
                                    string="Submit to openIMIS" 
                                    class="btn-primary"
                                    attrs="{'invisible': [('is_insurance_claim', '=', False)]}"/>
                            <button name="action_refresh_claim_status" 
                                    type="object" 
                                    string="Refresh Claim Status" 
                                    class="btn-secondary"
                                    attrs="{'invisible': [('openimis_claim_id', '=', False)]}"/>
                        </group>
                    </page>
                </xpath>
                
                <!-- Add insurance fields to invoice search view -->
                <xpath expr="//search" position="inside">
                    <filter name="is_insurance_claim" string="Insurance Claims" domain="[('is_insurance_claim', '=', True)]"/>
                    <filter name="claim_status" string="Claim Status" domain="[]">
                        <field name="claim_status"/>
                    </filter>
                    <field name="openimis_claim_id"/>
                    <field name="coverage_ref"/>
                </xpath>
            </field>
        </record>

        <!-- Modify invoice tree view to include insurance columns -->
        <record id="account_move_tree_view_insurance" model="ir.ui.view">
            <field name="name">account.move.tree.view.insurance</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//tree" position="inside">
                    <field name="is_insurance_claim" width="30px" optional="hide"/>
                    <field name="claim_status" optional="hide"/>
                    <field name="openimis_claim_id" optional="hide"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
